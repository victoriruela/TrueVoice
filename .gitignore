# Prevent accidental commits of large archive files
*.zip

# Python cache
__pycache__/
*.pyc

# Installer transient build artifacts
dist/staging/
dist/tmp/
dist/portable_staging*/
dist/TrueVoice_pruebas/
dist/TrueVoiceInstaller.exe
dist/*.log

# Runtime-generated config and data (not source)
frontend_config.json
truevoice-go/frontend_config.json
truevoice-go/contexts/
truevoice-go/internal/server/contexts/contexts.json

# Runtime data directories (user content, sessions)
voices/
race_sessions/
training_data/
loras/
temp_outputs/
api_outputs/

# Compiled binaries
truevoice-go/*.exe

# IDE / editor artifacts
.idea/

